#!/usr/bin/expect -f
set timeout 60
set host "47.112.156.183"
set user "root"
set password "\$8kL#mP2@666"

spawn ssh -o StrictHostKeyChecking=no $user@$host
expect "password:" { send "$password\r" }
expect "# "

# Write a verification script
send "cat > /tmp/verify.py << 'PYEOF'\n"
send "import urllib.request, json\n"
send "req = urllib.request.Request('http://127.0.0.1:3008/api/v1/auth/login/', data=json.dumps({'username':'chensheng','password':'chensheng123'}).encode(), headers={'Content-Type':'application/json'})\n"
send "resp = urllib.request.urlopen(req)\n"
send "d = json.loads(resp.read())\n"
send "print('LOGIN OK')\n"
send "print('user:', d['data']['user']['name'])\n"
send "print('roleId:', d['data']['user']['roleId'])\n"
send "print('permissions:', d['data']['user']['permissions'])\n"
send "token = d['data']['access_token']\n"
send "# Test /auth/me\n"
send "req2 = urllib.request.Request('http://127.0.0.1:3008/api/v1/auth/me/', headers={'Authorization': 'Bearer ' + token})\n"
send "resp2 = urllib.request.urlopen(req2)\n"
send "d2 = json.loads(resp2.read())\n"
send "print('ME OK')\n"
send "print('permissions:', d2['data']['user']['permissions'])\n"
send "PYEOF\n"
expect "# "

send "python3 /tmp/verify.py 2>&1\r"
expect "# "
send "echo VERIFY_DONE\r"
expect "VERIFY_DONE"
