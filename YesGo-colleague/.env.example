# Django 基础配置
DJANGO_SECRET_KEY=test-secret
# 仅本地排查时开启；关闭时未处理 API 异常仅返回“内部服务器错误”
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,::1,testserver,localadmin.yesgo.86lw.cc
CONTROL_ADMIN_HOSTS=testserver,localadmin.yesgo.86lw.cc,admin.yesgo.test,admin.yesgo.com

# Token / 会话配置
AUTH_TOKEN_ISSUER=yesgo
AUTH_TOKEN_SIGNING_KEY=test-secret
# Access token 有效期，单位秒，默认 15 分钟
AUTH_TOKEN_ACCESS_TTL_SECONDS=900
# Refresh token 有效期，单位秒，默认 7 天
AUTH_TOKEN_REFRESH_TTL_SECONDS=604800
# 前端提前刷新 access token 的窗口，单位秒，默认 30 分钟
AUTH_TOKEN_REFRESH_EARLY_SECONDS=1800
AUTH_TOKEN_SESSION_CACHE_PREFIX=mc:auth:session:
AUTH_TOKEN_BLACKLIST_CACHE_PREFIX=mc:auth:blacklist:

# PostgreSQL 配置
POSTGRES_HOST=192.168.2.180
POSTGRES_PORT=5432
POSTGRES_DB=yesgo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSLMODE=prefer
DATABASE_URL=

# Dify 配置
DIFY_BASE_URL=https://dify.86lw.cc/v1
DIFY_PROCUREMENT_API_KEY=app-k00vESAlXYrm0XR2dFJhVWVW
DIFY_OPERATIONS_API_KEY=app-MTlXmHhCJo6U2nUyAdKVX5jH
DIFY_MARKETING_API_KEY=app-PI4Gu03hHZIBSDZrySf0mZ87
DIFY_DISTRIBUTION_API_KEY=change-me
DIFY_ACADEMIC_API_KEY=change-me
DIFY_PROCUREMENT_WORKFLOW_CODE=procurement
DIFY_OPERATIONS_WORKFLOW_CODE=operations
DIFY_MARKETING_WORKFLOW_CODE=marketing
DIFY_DISTRIBUTION_WORKFLOW_CODE=distribution
DIFY_ACADEMIC_WORKFLOW_CODE=academic

# Kafka 配置
KAFKA_BOOTSTRAP_SERVERS=192.168.2.180:9092
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_TOPIC_PREFIX=yesgo.local

# OSS 配置
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=yesgo-assets
OSS_ACCESS_KEY_ID=replace-me
OSS_ACCESS_KEY_SECRET=replace-me
OSS_PUBLIC_BASE_URL=https://static.example.com
# 留空表示直接使用 Bucket 根目录；仅在需要环境级命名空间时设置相对前缀
OSS_ROOT_PREFIX=
LOGIN_FAILURE_THRESHOLD=3
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_CAPTCHA_CHALLENGE_TTL_SECONDS=120
LOGIN_CAPTCHA_TOKEN_TTL_SECONDS=120
LOGIN_CAPTCHA_MAX_ATTEMPTS=5
TRUSTED_PROXY_CIDRS=
