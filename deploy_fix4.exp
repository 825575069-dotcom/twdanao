#!/usr/bin/expect -f
set timeout 300
log_user 1

spawn ssh -o StrictHostKeyChecking=no -o ServerAliveInterval=30 root@47.112.156.183
expect {
    "password:" { send "\$8kL#mP2@666\r" }
    timeout { exit 1 }
}
expect "# "

# Extract frontend
send "cd /home/web/twdanao && rm -rf frontend/assets && mkdir -p frontend && cd frontend && tar xzf ../frontend-dist.tar.gz && rm -f ../frontend-dist.tar.gz\r"
expect "# "

# Create directories
send "mkdir -p /home/web/twdanao/run /home/web/logs\r"
expect "# "

# Kill old Gunicorn
send "pkill -f gunicorn 2>/dev/null; sleep 2\r"
expect "# "

# Start Gunicorn from yesgo-backend
send "cd /home/web/twdanao/yesgo-backend && source /home/web/twdanao/venv/bin/activate && GUNICORN_DAEMON=true setsid gunicorn config.wsgi:application -c gunicorn.conf.py 2>&1 | tail -3\r"
expect "# "

# Health check
send "sleep 3 && curl -s http://127.0.0.1:3008/api/v1/health/\r"
expect "# "

# Test login
send "curl -s -X POST http://127.0.0.1:3008/api/v1/auth/login -H 'Content-Type: application/json' -d '{\"username\":\"chensheng\",\"password\":\"chensheng123\"}'\r"
expect "# "

# Test members with token
send "TOKEN=\$(curl -s -X POST http://127.0.0.1:3008/api/v1/auth/login -H 'Content-Type: application/json' -d '{\"username\":\"chensheng\",\"password\":\"chensheng123\"}' | python3 -c 'import sys,json; d=json.load(sys.stdin); print(d.get(\"data\",{}).get(\"access_token\",\"\"))') && echo TOKEN=\$TOKEN\r"
expect "# "

send "curl -s http://127.0.0.1:3008/api/v1/tenant/members -H \"Authorization: Bearer \$TOKEN\" | python3 -m json.tool 2>&1 | head -20\r"
expect "# "

send "curl -s http://127.0.0.1:3008/api/v1/tenant/info -H \"Authorization: Bearer \$TOKEN\" | python3 -m json.tool\r"
expect "# "

send "curl -s http://127.0.0.1:3008/api/v1/models/list -H \"Authorization: Bearer \$TOKEN\" | python3 -m json.tool 2>&1 | head -10\r"
expect "# "

send "exit\r"
expect eof
