# YesGo 天网大脑 — 生产环境配置
# 存放路径：/home/web/twdanao/yesgo-backend/.env

# 运行模式
DEBUG=False
DB_ENGINE=mysql

# Django
SECRET_KEY=yesgo-tianwang-production-2026-secure-key-8kLmP2
ALLOWED_HOSTS=twdanao.88yldh.com,twdanaob.88yldh.com,twdanaom.88yldh.com,127.0.0.1,localhost

# MySQL 数据库
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=twdanao
MYSQL_USER=root
MYSQL_PASSWORD=YesGo@2026#Secure

# Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REDIS_CACHE_URL=redis://localhost:6379/2

# CORS（生产环境）
CORS_ORIGINS=https://twdanao.88yldh.com,https://twdanaom.88yldh.com,http://localhost:5180

# Gunicorn
GUNICORN_BIND=127.0.0.1:3008
GUNICORN_WORKERS=4
GUNICORN_LOG_LEVEL=info

# 前端构建目录（Nginx 静态文件服务）
FRONTEND_DIR=/home/web/twdanao/frontend
MOBILE_DIR=/home/web/twdanao/mobile
