#!/usr/bin/expect -f
set timeout 600
set host "47.112.156.183"
set user "root"
set password {$8kL#mP2@666}

spawn scp -o StrictHostKeyChecking=no /tmp/yesgo-backend.tar.gz $user@$host:/tmp/
expect {
    "password:" { send "$password\r" }
    timeout { puts "\nSCP timeout"; exit 1 }
}
expect eof

spawn ssh -o StrictHostKeyChecking=no $user@$host
expect {
    "password:" { send "$password\r" }
    timeout { puts "\nSSH timeout"; exit 1 }
}
expect "# "

# Remove server-generated bogus migrations (columns already exist in prod DB)
send "rm -f /home/web/twdanao/yesgo-backend/apps/platform/migrations/0002_tenant_created_by.py /home/web/twdanao/yesgo-backend/apps/platform/migrations/0003_role_permissions.py && echo BOGUS_REMOVED\r"
expect "BOGUS_REMOVED"

send "cd /home/web/twdanao/yesgo-backend && tar xzf /tmp/yesgo-backend.tar.gz -C /home/web/twdanao/yesgo-backend/ && echo EXTRACTED\r"
expect "EXTRACTED"

send "cd /home/web/twdanao/yesgo-backend && source /home/web/twdanao/venv/bin/activate && python manage.py migrate --noinput 2>&1 | tail -12 && echo MIGRATE_DONE\r"
expect "MIGRATE_DONE"

send "cd /home/web/twdanao/yesgo-backend && source /home/web/twdanao/venv/bin/activate && python manage.py seed 2>&1 | tail -4 && echo SEED_DONE\r"
expect "SEED_DONE"

send "kill \$(cat /home/web/twdanao/run/gunicorn.pid 2>/dev/null) 2>/dev/null; sleep 2; cd /home/web/twdanao/yesgo-backend && GUNICORN_DAEMON=true setsid /home/web/twdanao/venv/bin/gunicorn config.wsgi:application -c gunicorn.conf.py; sleep 4; echo GUNICORN_RESTARTED\r"
expect "GUNICORN_RESTARTED"

send "echo HEALTH:; curl -s http://127.0.0.1:3008/api/v1/health/; echo; echo PROMPTS_HOME_COUNT:; curl -s 'http://127.0.0.1:3008/api/v1/prompts/?type=home' | python3 -c 'import sys,json; d=json.load(sys.stdin); print(\"code=\",d.get(\"code\"),\"count=\",len(d.get(\"data\",[])))'; echo PROMPTS_CHAT_COUNT:; curl -s 'http://127.0.0.1:3008/api/v1/prompts/?type=chat' | python3 -c 'import sys,json; d=json.load(sys.stdin); print(\"code=\",d.get(\"code\"),\"count=\",len(d.get(\"data\",[])))'; echo; echo BACKEND_DEPLOY_DONE\r"
expect "BACKEND_DEPLOY_DONE"

send "exit\r"
expect eof
