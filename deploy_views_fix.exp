#!/usr/bin/expect -f
set timeout 120
set host "47.112.156.183"
set user "root"
set password "\$8kL#mP2@666"

# SCP updated views.py
spawn scp -o StrictHostKeyChecking=no /Users/chenshenghe/WorkBuddy/2026-07-18-19-21-50/yesgo-backend/apps/platform/views.py $user@$host:/home/web/twdanao/yesgo-backend/apps/platform/views.py
expect {
    "password:" {
        send "$password\r"
        exp_continue
    }
    eof
}

# Restart Gunicorn and verify
spawn ssh -o StrictHostKeyChecking=no $user@$host
expect "password:" { send "$password\r" }
expect "# "

send "pkill -9 -f gunicorn 2>/dev/null; sleep 1; rm -f /home/web/twdanao/run/gunicorn.pid\r"
expect "# "
send "cd /home/web/twdanao/yesgo-backend && export GUNICORN_DAEMON=true DB_ENGINE=mysql MYSQL_HOST=127.0.0.1 MYSQL_PORT=3306 MYSQL_DB=twdanao MYSQL_USER=root MYSQL_PASSWORD='YesGo@2026#Secure' PYTHONPATH=/home/web/twdanao/yesgo-backend && setsid /home/web/twdanao/venv/bin/gunicorn config.wsgi:application --config gunicorn.conf.py --pythonpath /home/web/twdanao/yesgo-backend &>/dev/null &\r"
expect "# "

# Wait and test login
send "sleep 3 && curl -s -X POST http://127.0.0.1:3008/api/v1/auth/login/ -H 'Content-Type: application/json' -d '{\"username\":\"chensheng\",\"password\":\"chensheng123\"}' 2>&1 | python3 -c \"import sys,json; d=json.load(sys.stdin); print('permissions:', d['data']['user']['permissions'])\"\r"
expect "# "
send "echo 'DEPLOY_COMPLETE'\r"
expect "DEPLOY_COMPLETE"
