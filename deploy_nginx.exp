#!/usr/bin/expect -f
set timeout 60
set host "47.112.156.183"
set user "root"
set password "\$8kL#mP2@666"

# SCP the nginx configs
spawn scp -o StrictHostKeyChecking=no /tmp/nginx_twdanao.tar.gz $user@$host:/tmp/nginx_twdanao.tar.gz
expect {
    "password:" {
        send "$password\r"
        exp_continue
    }
    eof
}

# SSH to extract, reload nginx, lock files
spawn ssh -o StrictHostKeyChecking=no $user@$host
expect "password:" { send "$password\r" }
expect "# "

# Extract configs
send "tar xzf /tmp/nginx_twdanao.tar.gz -C /etc/nginx/conf.d/\r"
expect "# "

# Verify files
send "ls -la /etc/nginx/conf.d/twdanao*\r"
expect "# "

# Test nginx config
send "nginx -t 2>&1\r"
expect "# "

# Reload nginx
send "nginx -s reload\r"
expect "# "

# Wait and verify
send "sleep 1\r"
expect "# "
send "curl -s -o /dev/null -w '%{http_code}' https://twdanaob.88yldh.com/admin/ -k\r"
expect "# "
send "curl -s -o /dev/null -w '%{http_code}' https://twdanao.88yldh.com/ -k\r"
expect "# "
send "curl -s -o /dev/null -w '%{http_code}' https://twdanaom.88yldh.com/ -k\r"
expect "# "

# Lock the files with chattr
send "chattr +i /etc/nginx/conf.d/twdanao.88yldh.com.conf /etc/nginx/conf.d/twdanaob.88yldh.com.conf /etc/nginx/conf.d/twdanaom.88yldh.com.conf\r"
expect "# "
send "lsattr /etc/nginx/conf.d/twdanao*\r"
expect "# "

send "echo NGINX_DEPLOY_DONE\r"
expect "NGINX_DEPLOY_DONE"
