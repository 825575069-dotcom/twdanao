#!/usr/bin/expect -f
set timeout 120
set host "47.112.156.183"
set user "root"
set password "\$8kL#mP2@666"

# Step 1: SCP the tar archive to server
spawn scp -o StrictHostKeyChecking=no /tmp/rbac_perms_update.tar.gz $user@$host:/tmp/
expect {
    "password:" {
        send "$password\r"
        exp_continue
    }
    eof
}

# Step 2: SSH to extract and restart
spawn ssh -o StrictHostKeyChecking=no $user@$host
expect "password:" { send "$password\r" }
expect "# "

# Backup current files
send "cd /home/web/twdanao/yesgo-backend && cp -r apps/platform/views.py apps/platform/views.py.bak && cp -r apps/dashboard/views.py apps/dashboard/views.py.bak && cp -r apps/model_gateway/views.py apps/model_gateway/views.py.bak && cp -r apps/model_gateway/views_ext.py apps/model_gateway/views_ext.py.bak && cp -r apps/security/views.py apps/security/views.py.bak && cp -r apps/tenant_db/views.py apps/tenant_db/views.py.bak && cp -r apps/tenant_ext/views.py apps/tenant_ext/views.py.bak && cp -r apps/chat/views.py apps/chat/views.py.bak && cp -r apps/memory_engine/views.py apps/memory_engine/views.py.bak && echo 'BACKUP_DONE'\r"
expect "BACKUP_DONE"
expect "# "

# Extract new files
send "cd /home/web/twdanao/yesgo-backend && tar xzf /tmp/rbac_perms_update.tar.gz && echo 'EXTRACT_DONE'\r"
expect "EXTRACT_DONE"
expect "# "

# Verify permissions.py exists
send "ls -la /home/web/twdanao/yesgo-backend/apps/platform/permissions.py\r"
expect "# "

# Restart Gunicorn
send "pkill -9 -f gunicorn 2>/dev/null; sleep 1; rm -f /home/web/twdanao/run/gunicorn.pid\r"
expect "# "
send "cd /home/web/twdanao/yesgo-backend && export GUNICORN_DAEMON=true DB_ENGINE=mysql MYSQL_HOST=127.0.0.1 MYSQL_PORT=3306 MYSQL_DB=twdanao MYSQL_USER=root MYSQL_PASSWORD='YesGo@2026#Secure' PYTHONPATH=/home/web/twdanao/yesgo-backend && setsid /home/web/twdanao/venv/bin/gunicorn config.wsgi:application --config gunicorn.conf.py --pythonpath /home/web/twdanao/yesgo-backend &>/dev/null &\r"
expect "# "

# Wait and verify
send "sleep 3 && curl -s http://127.0.0.1:3008/api/v1/health/ 2>&1\r"
expect "# "

# Test permission enforcement - login as superuser to verify API works
send "curl -s -X POST http://127.0.0.1:3008/api/v1/auth/login/ -H 'Content-Type: application/json' -d '{\"username\":\"chensheng\",\"password\":\"chensheng123\"}' 2>&1 | head -200\r"
expect "# "

send "echo 'DEPLOY_COMPLETE'\r"
expect "DEPLOY_COMPLETE"
